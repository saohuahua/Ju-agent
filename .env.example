# 数据库文件路径 默认写入本地 data 目录
DB_PATH=./data/app.db

# API 服务端口
API_PORT=8787

# 演示环境固定令牌 生产环境必须替换为真实认证体系
OPERATOR_TOKEN=operator-token
SUPERVISOR_TOKEN=supervisor-token

# 模型参数供本地设置页预填 启动本身不会调用真实模型
MODEL_PROTOCOL=anthropic_messages
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
MODEL_INPUT_CNY_PER_MILLION=
MODEL_OUTPUT_CNY_PER_MILLION=
MODEL_AUTO_ENABLE=0

# 可选 自定义服务地址 用于代理或中转站 留空走官方 api.anthropic.com
ANTHROPIC_BASE_URL=
OPENAI_BASE_URL=

# 可选 固定本机模型管理口令 不配置时由 API 启动时随机生成
MODEL_LOCAL_TOKEN=
